  {
   "args": [
    "display",
    "-p",
    "-t",
    "$1",
    "#{session_id}\t#{window_id}\t#{window_width}\t#{window_height}\t#{window_zoomed_flag}"
   ],
   "stdout": "$1\t@1\t100\t30\t0\n"

   ],
   "stdout": "%1\t0\t0\t0\t100\t30\t1\t0\t0\tsleep\n"
  },
  {
   "args": [
    "capture-pane",
    "-p",
    "-e",
    "-t",
    "%1"
   ],
   "stdout": "$ ls\n\u001b[1m\u001b[34mdir\u001b[0m  file.txt  \u001b[32mrun.sh\u001b[39m\n$ echo hi\nhi\n$\n\u001b[31mred line one\u001b[39m\n\u001b[31mstill red\u001b[39m back\n\u001b[38;5;208morange\u001b[39m\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
  }
 ]

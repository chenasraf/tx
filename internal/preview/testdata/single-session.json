 "home": "/private/tmp/txfix/home",
 "calls": [
  {
   "args": [
    "display",
    "-p",
    "#{@thm_sky}\t#{@thm_overlay_0}\t#{@thm_overlay_1}\t#{@thm_blue}\t#{@thm_green}\t#{@thm_subtext_0}\t#{@thm_text}\t#{@thm_peach}\t#{@thm_red}"
